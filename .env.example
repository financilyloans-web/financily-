# ────────────────────────────────────────────────────────────
#  FINANCILY · Environment Variables
#  Copy this file to `.env.local` and fill in your values.
# ────────────────────────────────────────────────────────────

# Firebase Authentication + Firestore configuration
# Create a project at https://console.firebase.google.com
# Enable: Authentication (Email/Password + Google Sign-in) and Cloud Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "Continue with Google" on the login/signup pages uses Firebase Google sign-in.
# Make sure Google Sign-in is enabled in Firebase Console → Authentication → Sign-in method.
# The app builds and runs without these variables. When they are absent,
# auth pages and the dashboard show a friendly "not configured" notice and
# the lead form falls back to local storage.

# ────────────────────────────────────────────────────────────
#  YouPI PG — self-hosted UPI payment gateway (server-side only)
# ────────────────────────────────────────────────────────────
# Used by the "Pay EMI" flow. These are SERVER-side secrets — never expose
# them via NEXT_PUBLIC_*. When absent, the Pay EMI button shows a friendly
# "not configured" state.
#
# YOUPI_API_URL is the base URL of your self-hosted YouPI instance
# (e.g. http://localhost:7000 in dev, or https://pay.yourdomain.com).
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=

# Optional: absolutely URL to return the customer to after a checkout.
# YOUPI_RETURN_URL=
