# ────────────────────────────────────────────────────────────
#  FINANCILY · Environment Variables
#  Copy this file to `.env.local` and fill in your values.
# ────────────────────────────────────────────────────────────

# Firebase Authentication + Firestore configuration
# Create a project at https://console.firebase.google.com
# Enable: Authentication (Email/Password + Google Sign-in) and Cloud Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "Continue with Google" on the login/signup pages uses Firebase Google sign-in.
# Make sure Google Sign-in is enabled in Firebase Console → Authentication → Sign-in method.
# The app builds and runs without these variables. When they are absent,
# auth pages and the dashboard show a friendly "not configured" notice and
# the lead form falls back to local storage.

# ────────────────────────────────────────────────────────────
#  YouPI PG — Universal checkout (client-side, one-script)
# ────────────────────────────────────────────────────────────
# The "Pay EMI" flow uses the YouPI universal script (youpi.js), loaded from your
# self-hosted checkout host. The browser receives the merchant PUBLIC key (safe).
#
#   NEXT_PUBLIC_YOUPI_CHECKOUT_URL   base URL of your YouPI checkout portal
#                                    (e.g. https://pay.yourdomain.com) — must be
#                                    https (or localhost) or it is rejected.
#   NEXT_PUBLIC_YOUPI_PUBLIC_KEY     merchant public key from the YouPI admin
#   NEXT_PUBLIC_YOUPI_SCRIPT_INTEGRITY  (optional) SRI hash (sha384-...) for the
#                                    youpi.js script to pin its integrity. If
#                                    omitted, no SRI is applied.
#
# When absent, the Pay EMI button shows a friendly "not configured" state.
NEXT_PUBLIC_YOUPI_CHECKOUT_URL=
NEXT_PUBLIC_YOUPI_PUBLIC_KEY=
# NEXT_PUBLIC_YOUPI_SCRIPT_INTEGRITY=sha384-EXAMPLE

# ────────────────────────────────────────────────────────────
#  YouPI PG — server-side (webhook verification, admin)
# ────────────────────────────────────────────────────────────
# Server-side secrets — never expose via NEXT_PUBLIC_*.
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=

# Optional: absolute URL to return the customer to after a checkout.
# YOUPI_RETURN_URL=

# ────────────────────────────────────────────────────────────
#  Payment receiver / beneficiary (displayed to the customer)
# ────────────────────────────────────────────────────────────
# These are public payee details shown in the Pay EMI dialog. Override via
# NEXT_PUBLIC_* if needed; defaults are in lib/paymentReceiver.ts.
# NEXT_PUBLIC_PAYEE_NAME=Good Life Enterprises
# NEXT_PUBLIC_UPI_ID=8269581567-2@ybl
# NEXT_PUBLIC_RECEIVER_ACCOUNT=4508020001131836
# NEXT_PUBLIC_RECEIVER_IFSC=jsfb0004508
# NEXT_PUBLIC_RECEIVER_BANK=Jana Small Finance Bank
