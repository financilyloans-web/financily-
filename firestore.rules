rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Sensitive KYC values must never be written in plaintext. Reject any
    // write that tries to store raw `pan` or `aadhaar` fields.
    function rawKycBlocked() {
      return !("pan" in request.resource.data)
        && !("aadhaar" in request.resource.data);
    }

    // A submitted document must be attributed to the authenticated user
    // (never the sentinel "guest") and must not carry raw KYC.
    function authedAppend() {
      return request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.uid is string
        && request.resource.data.uid != "guest"
        && rawKycBlocked();
    }

    // Internal staff roster (email -> role). Reads are scoped to the user's
    // OWN email: an authenticated user may read exactly their own staff doc.
    // This lets an agent/employee verify their own role at login while
    // preventing a public user from enumerating the whole roster (a list/all
    // query would fail the rule, leaking no other emails). Writes are admin-only.
    //
    // Staff docs MUST be keyed by the normalized email (document id == email).
    // This is the canonical layout. The `exists()` check below (used to gate the
    // internal `cases` and `workflow_history` collections) relies on that doc id,
    // and Firestore rules cannot query by field — so `lib/staff.ts` uses the same
    // canonical doc-id lookup. Legacy auto-ID docs are not supported.
    function staffDocNamed(email) {
      return email != null
        && exists(/databases/$(database)/documents/staff/$(email));
    }

    match /staff/{staffId} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && (staffId == request.auth.token.email
            || resource.data.email == request.auth.token.email);
      allow write: if false;
    }

    // Staff case-management collections. Only authenticated members of the
    // staff roster may read/write cases, and the audit trail is append-only.
    // This keeps applicant loan data private to the internal team.
    match /cases/{caseId} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && staffDocNamed(request.auth.token.email);
      allow create, update: if request.auth != null
        && request.auth.token.email != null
        && staffDocNamed(request.auth.token.email);
      allow delete: if false;
    }

    match /workflow_history/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && staffDocNamed(request.auth.token.email);
      allow create: if request.auth != null
        && request.auth.token.email != null
        && staffDocNamed(request.auth.token.email);
      allow update, delete: if false;
    }

    // Lead capture is authenticated and append-only. Only the signed-in user
    // may record a lead under their own uid; the project owner reads via the
    // console. Raw KYC is always blocked.
    match /leads/{leadId} {
      allow create: if authedAppend()
        && request.resource.data.fullName is string
        && request.resource.data.mobile is string
        && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // A user may manage their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid != "guest"
        && rawKycBlocked();

      // Loan applications and saved requests live under the user's own doc.
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && request.auth.uid == request.resource.data.uid
          && request.resource.data.uid != "guest"
          && rawKycBlocked();
      }

      match /savedRequests/{requestId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.uid != "guest"
          && rawKycBlocked();
      }
    }
  }
}
